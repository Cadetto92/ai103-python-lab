# Copy this file to .env and set the values before running a script.
# Keep .env private; it is ignored by Git.

# 01_openai_azure_api_key.py - newer OpenAI v1 API with an Azure OpenAI API key.
# Azure OpenAI API key for the resource.
AZURE_OPENAI_API_KEY_01=
# Azure OpenAI resource name without https:// or a domain suffix.
AZURE_OPENAI_RESOURCE_NAME_01=
# Azure model deployment name.
DEPLOYMENT_NAME_01=

# 02_openai_entra_id.py - newer OpenAI v1 API with an Entra ID user bearer token.
# Azure OpenAI resource name without https:// or a domain suffix.
AZURE_OPENAI_RESOURCE_NAME_02=
# Azure model deployment name.
DEPLOYMENT_NAME_02=

# 03_azure_openai_azure_api_key.py - older AzureOpenAI API-version method with an API key.
# Azure OpenAI API key for the resource.
AZURE_OPENAI_API_KEY_03=
# Azure OpenAI API version, for example 2024-10-21.
AZURE_OPENAI_API_VERSION_03=
# Azure OpenAI resource name without https:// or a domain suffix.
AZURE_OPENAI_RESOURCE_NAME_03=
# Azure model deployment name.
DEPLOYMENT_NAME_03=

# 04_azure_openai_entra_id.py - older AzureOpenAI API-version method with an Entra ID user bearer token.
# Azure OpenAI API version, for example 2024-10-21.
AZURE_OPENAI_API_VERSION_04=
# Azure OpenAI resource name without https:// or a domain suffix.
AZURE_OPENAI_RESOURCE_NAME_04=
# Azure model deployment name.
DEPLOYMENT_NAME_04=

# 05_foundry_entra_id.py - Microsoft Foundry with a credential passed directly to the client.
# Microsoft Foundry resource name without https:// or a domain suffix.
FOUNDRY_RESOURCE_NAME_05=
# Microsoft Foundry project name.
FOUNDRY_PROJECT_NAME_05=
# Azure model deployment name.
DEPLOYMENT_NAME_05=
